# PayPal Assist (ResolveAI) - Environment Configuration

# Server Port
PORT=3000

# AI Provider Configuration (Defaults to Claude API / Anthropic)
# When ANTHROPIC_API_KEY is supplied, PayPal Assist calls Claude 3.7 Sonnet with native function calling.
# If omitted or left empty, PayPal Assist seamlessly utilizes its built-in ResolveAI reasoning engine.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-7-sonnet-20250219

# PayPal Developer Sandbox Credentials
# Register at developer.paypal.com to obtain Sandbox API keys
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
