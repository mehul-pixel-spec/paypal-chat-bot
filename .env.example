# PayPal Assist (ResolveAI) - Environment Configuration

# Server Port
PORT=3000

# PayPal Environment: sandbox or live (defaults to sandbox)
PAYPAL_ENV=sandbox

# PayPal Developer Sandbox Credentials
# Get these from https://developer.paypal.com/dashboard/applications/sandbox
# Put your real sandbox credentials ONLY in your local .env file (never in git or chat)
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here

# PayPal Webhook ID (from Webhooks configuration in Developer Dashboard)
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# AI / LLM Provider Key (Optional: Claude Anthropic key)
# Leave empty to run the built-in intelligent ResolveAI engine
LLM_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-7-sonnet-20250219
